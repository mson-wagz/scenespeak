{
  "name": "react-native-multi-tv-app-sample",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "yarn@4.5.0",
  "resolutions": {
    "js-yaml": "^3.15.1",
    "min-document": "^2.19.1",
    "logkitty": "^0.7.1",
    "node-fetch": "^2.6.7",
    "ws": "^8.21.0"
  },
  "scripts": {
    "dev": "node init && yarn workspace @multi-tv/expo-multi-tv start",
    "dev:android": "node init && yarn workspace @multi-tv/expo-multi-tv android",
    "dev:ios": "node init && yarn workspace @multi-tv/expo-multi-tv ios",
    "dev:web": "node init && yarn workspace @multi-tv/expo-multi-tv web",
    "dev:vega": "node init && yarn workspace @multi-tv/vega start",
    "build:all": "node init && yarn workspaces foreach -A -pt run build",
    "build:vega": "node init && yarn workspace @multi-tv/vega run build",
    "build:vega:debug": "node init && yarn workspace @multi-tv/vega run build:debug",
    "test:all": "yarn workspaces foreach -A -pt run test",
    "lint:all": "yarn workspaces foreach -A -pt run lint",
    "typecheck": "yarn workspaces foreach -A -pt run typecheck",
    "clean:all": "yarn workspaces foreach -A run clean && rm -rf node_modules",
    "bootstrap": "yarn install && yarn build:all",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.6",
    "prettier": "^3.3.3"
  }
}
